{
  "name": "dsh-skills-workbench",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "技能工作台：技能唤起面板 + 落地目录主动同步（Skill launcher panel with live directory sync）",
  "license": "MIT",
  "author": "穆咚",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "data/*.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  }
}
